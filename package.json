{
  "name": "gloss",
  "productName": "Gloss",
  "version": "0.1.0",
  "description": "Graphical Layer Over Shell Sessions: a desktop GUI for coding agents with threaded replies.",
  "license": "MIT",
  "author": "Wyatt Marvil",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "probe:opencode": "node scripts/probe-opencode.mjs",
    "bench:new-session": "node scripts/bench-new-session.mjs",
    "bench:app-startup": "node scripts/bench-app-startup.mjs",
    "postinstall": "patch-package",
    "icons": "electron scripts/make-icons.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.89.1",
    "@agentclientprotocol/codex-acp": "2.2.2",
    "@agentclientprotocol/sdk": "1.8.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.293",
    "@fontsource-variable/inter": "5.3.0",
    "koffi": "3.3.3",
    "lucide-react": "1.60.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@eslint/js": "^10.0.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "diff": "^9.0.0",
    "electron": "44.7.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.0.0",
    "jsdom": "^30.1.2",
    "patch-package": "^8.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.4.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "unified": "^11.0.5",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  }
